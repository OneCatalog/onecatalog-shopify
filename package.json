{
  "name": "onecatalog-shopify",
  "private": true,
  "version": "0.2.0",
  "description": "OneCatalog catalog import + B2B sync — Shopify public app (Remix)",
  "license": "MIT",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "prisma": "prisma",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "remix-serve ./build/server/index.js",
    "test": "node tests/units-test.mjs && node tests/pricestock-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "@shopify/app-bridge-react": "^4.1.0",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-remix": "^3.4.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.1.0",
    "isbot": "^5.1.0",
    "prisma": "^5.18.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": "^18.20 || ^20.10 || >=21"
  }
}
